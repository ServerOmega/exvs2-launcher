<Window x:Class="Exvs2Launcher.App.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Diagnostics bundle" Width="900" Height="640" MinWidth="700" MinHeight="460"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="12">
    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
               Text="This zip helps someone else see what went wrong. Card codes, chip ids, passwords, tokens, the n2n community and public IP addresses are masked, and your Windows user name is replaced. Game files, executables and assets are never included. Click a file to preview exactly what will be saved." />
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="Gray" />
      <Button Content="Save zip…" Click="Save_Click" IsDefault="True" FontWeight="SemiBold" Padding="12,4" Margin="0,0,8,0" />
      <Button Content="Cancel" IsCancel="True" Padding="12,4" />
    </StackPanel>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="320" />
        <ColumnDefinition Width="6" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <ListBox x:Name="EntryList" SelectionChanged="EntryList_SelectionChanged">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="0,2">
              <TextBlock Text="{Binding ZipPath}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Description}" Foreground="Gray" TextWrapping="Wrap" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" />
      <TextBox x:Name="PreviewBox" Grid.Column="2" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
    </Grid>
  </DockPanel>
</Window>
