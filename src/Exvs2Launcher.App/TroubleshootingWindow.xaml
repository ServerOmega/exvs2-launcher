<Window x:Class="Exvs2Launcher.App.TroubleshootingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Troubleshooting" Width="620" Height="520"
        WindowStartupLocation="CenterOwner"
        ToolTipService.InitialShowDelay="700"
        ToolTipService.ShowDuration="20000">
  <DockPanel Margin="14">
    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10"
               Text="Plain-English notes for the errors people hit most often. The launcher does not change firewall rules or other programs for you." />
    <Button DockPanel.Dock="Bottom" Content="Close" HorizontalAlignment="Right" IsCancel="True" IsDefault="True" MinWidth="90" />
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <ItemsControl x:Name="TopicList">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Margin="0,0,0,12" Padding="10" Background="#FFF8FAFC" BorderBrush="#FFCBD5E1" BorderThickness="1" CornerRadius="3">
              <StackPanel>
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,0,0,4" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Body}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</Window>
