<Window x:Class="Exvs2Launcher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EXVS2 Launcher" Width="860" Height="820" MinWidth="720" MinHeight="600"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing">
  <DockPanel Margin="10">
    <!-- Profile bar -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
      <Label Content="Cab profile:" />
      <ComboBox x:Name="ProfileBox" Width="260" Margin="0,0,6,0" DisplayMemberPath="Name" SelectionChanged="ProfileBox_SelectionChanged" />
      <Button Content="New" Click="NewProfile_Click" />
      <Button Content="Delete" Click="DeleteProfile_Click" />
      <Button Content="Save" Click="Save_Click" />
      <TextBlock x:Name="StoreText" VerticalAlignment="Center" Foreground="Gray" Margin="6,0,0,0" TextTrimming="CharacterEllipsis" />
    </StackPanel>

    <!-- Start bar -->
    <Border DockPanel.Dock="Top" Margin="0,8,0,0" Padding="8" Background="#FFF3F6FA" BorderBrush="#FFCBD5E1" BorderThickness="1" CornerRadius="3">
      <StackPanel Orientation="Horizontal">
        <Button x:Name="StartButton" Content="Start" FontWeight="Bold" MinWidth="100" Click="Start_Click" />
        <Button x:Name="CancelButton" Content="Cancel" IsEnabled="False" Click="Cancel_Click" />
        <Button Content="Stop game" Click="StopGame_Click" ToolTip="Close the LM and client this launcher started. The card server keeps running." />
        <Button Content="Stop all" Click="StopAll_Click" ToolTip="Also close the card server this launcher started." />
        <Button Content="Check port" Click="CheckPort_Click" ToolTip="Show what is listening on the card server port." />
        <TextBlock x:Name="StageText" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="SemiBold" Text="Idle" />
      </StackPanel>
    </Border>

    <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto" MaxHeight="520">
      <StackPanel>
        <GroupBox Header="Cab">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="140" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
            </Grid.RowDefinitions>
            <Label Grid.Row="0" Content="Name" />
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="NameBox" />

            <Label Grid.Row="1" Content="Game folder" />
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="GameFolderBox" LostFocus="GameFolderBox_LostFocus" />
            <Button Grid.Row="1" Grid.Column="2" Content="Browse..." Click="BrowseGame_Click" />

            <Label Grid.Row="2" Content="Patched card server" />
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="ServerPathBox"
                     ToolTip="Server-Infinite.exe or 3-Start-Server.bat from exvs2-matchmaking. Never the pack's server\Server.exe." />
            <Button Grid.Row="2" Grid.Column="2" Content="Browse..." Click="BrowseServer_Click" />

            <Label Grid.Row="3" Content="Server arguments" />
            <TextBox Grid.Row="3" Grid.Column="1" x:Name="ServerArgsBox" ToolTip="Usually empty." />

            <Label Grid.Row="4" Content="Start" />
            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
              <CheckBox x:Name="StartServerCheck" Content="Card server" />
              <CheckBox x:Name="StartLmCheck" Content="LM (vsac29_Release_LM.exe)" />
              <CheckBox x:Name="StartClientCheck" Content="Client (vsac29_Release.exe)" />
            </StackPanel>

            <Label Grid.Row="5" Content="Card server address" />
            <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal">
              <TextBox x:Name="HostBox" Width="110" />
              <TextBlock Text=":" VerticalAlignment="Center" Margin="0,0,6,0" />
              <TextBox x:Name="PortBox" Width="60" />
              <Label Content="wait up to (s)" Margin="10,0,0,0" />
              <TextBox x:Name="TimeoutBox" Width="45" />
              <Label Content="LM → client delay (s)" Margin="10,0,0,0" />
              <TextBox x:Name="DelayBox" Width="40" />
            </StackPanel>
          </Grid>
        </GroupBox>

        <GroupBox Header="Identity (serial and card)">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="140" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
            </Grid.RowDefinitions>
            <Label Grid.Row="0" Content="Serial (config.ini)" />
            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="SerialText" VerticalAlignment="Center" FontFamily="Consolas" />
            <Button Grid.Row="0" Grid.Column="2" Content="New serial" Click="NewSerial_Click" />

            <Label Grid.Row="1" Content="Card (card.ini)" />
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="CardText" VerticalAlignment="Center" />
            <Button Grid.Row="1" Grid.Column="2" Content="New card" Click="NewCard_Click" />

            <Label Grid.Row="2" Content="Access code prefix" />
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
              <TextBox x:Name="PrefixBox" Width="60" ToolTip="Optional digits at the start of new access codes, e.g. 99 for a P2 cab." />
              <TextBlock Text="optional, e.g. 99" Foreground="Gray" VerticalAlignment="Center" />
            </StackPanel>

            <CheckBox Grid.Row="3" Grid.Column="1" x:Name="SyncSnowCheck"
                      Content="Also update SnowLauncher.ini if it exists (so SnowLauncher won't put old values back)" />
          </Grid>
        </GroupBox>

        <GroupBox Header="Network (PCB / LM IP)">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="140" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
            </Grid.RowDefinitions>
            <CheckBox Grid.Row="0" Grid.Column="1" x:Name="AutoIpCheck" Content="Detect this PC's LAN IP on every Start" />
            <Button Grid.Row="0" Grid.Column="2" Content="Detect now" Click="DetectIp_Click" />

            <Label Grid.Row="1" Content="PCB (client) IP" />
            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="PcbIpBox" IsEditable="True" Margin="0,2,6,2" />

            <Label Grid.Row="2" Content="LM IP" />
            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="LmIpBox" IsEditable="True" Margin="0,2,6,2" />
            <Button Grid.Row="2" Grid.Column="2" Content="Write IPs" Click="WriteIps_Click" />

            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="CurrentIpText" Foreground="Gray" TextWrapping="Wrap" />
          </Grid>
        </GroupBox>
      </StackPanel>
    </ScrollViewer>

    <DockPanel Margin="0,8,0,0">
      <TextBlock DockPanel.Dock="Top" Text="Log" FontWeight="SemiBold" />
      <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
               VerticalScrollBarVisibility="Auto" Margin="0,2,0,0" />
    </DockPanel>
  </DockPanel>
</Window>
