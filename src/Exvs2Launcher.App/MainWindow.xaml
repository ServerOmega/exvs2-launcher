<Window x:Class="Exvs2Launcher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EXVS2 Launcher" Width="940" Height="820" MinWidth="780" MinHeight="640"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing"
        ToolTipService.InitialShowDelay="700"
        ToolTipService.ShowDuration="30000"
        ToolTipService.BetweenShowDelay="200">
  <DockPanel Margin="10">
    <!-- Profile bar: always visible -->
    <DockPanel DockPanel.Dock="Top">
      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
        <Label Content="Cab profile:" ToolTip="{StaticResource Tip.Profile}" />
        <ComboBox x:Name="ProfileBox" Width="260" Margin="0,0,6,0" DisplayMemberPath="Name"
                  SelectionChanged="ProfileBox_SelectionChanged" ToolTip="{StaticResource Tip.Profile}" />
        <Button Content="New" Click="NewProfile_Click" ToolTip="{StaticResource Tip.ProfileNew}" />
        <Button Content="Delete" Click="DeleteProfile_Click" ToolTip="{StaticResource Tip.ProfileDelete}" />
        <Button Content="Save" Click="Save_Click" ToolTip="{StaticResource Tip.ProfileSave}" />
        <Button Content="Troubleshooting" Click="Troubleshooting_Click" ToolTip="{StaticResource Tip.Troubleshooting}" />
        <Button Content="Diagnostics..." Click="Diagnostics_Click" ToolTip="{StaticResource Tip.Diagnostics}" />
        <Button Content="Export..." Click="ExportProfile_Click" ToolTip="{StaticResource Tip.ExportProfile}" />
        <Button Content="Import..." Click="ImportProfile_Click" ToolTip="{StaticResource Tip.ImportProfile}" />
        <Button x:Name="UpdateNoticeButton" Content="Update available" Visibility="Collapsed" FontWeight="SemiBold"
                Foreground="DarkGreen" Click="UpdateNotice_Click" ToolTip="{StaticResource Tip.UpdateNotice}" />
      </StackPanel>
      <TextBlock x:Name="StoreText" VerticalAlignment="Center" Foreground="Gray" Margin="6,0,0,0"
                 TextWrapping="Wrap" ToolTip="{StaticResource Tip.ProfileStore}" />
    </DockPanel>

    <!-- Start / stop bar and component status: always visible -->
    <Border DockPanel.Dock="Top" Margin="0,8,0,0" Padding="8" Background="#FFF3F6FA" BorderBrush="#FFCBD5E1" BorderThickness="1" CornerRadius="3">
      <StackPanel>
        <Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <WrapPanel>
            <Button x:Name="StartButton" Content="Start all" FontWeight="Bold" MinWidth="100"
                    Click="Start_Click" ToolTip="{StaticResource Tip.StartAll}" />
            <Button x:Name="CancelButton" Content="Cancel" IsEnabled="False" Click="Cancel_Click"
                    ToolTip="{StaticResource Tip.Cancel}" />
            <Button x:Name="StopAllButton" Content="Stop all" Click="StopAll_Click"
                    ToolTip="{StaticResource Tip.StopAll}" />
            <Button Content="Check port" Click="CheckPort_Click" ToolTip="{StaticResource Tip.CheckPort}" />
            <Button x:Name="StartEverythingButton" Content="Start everything" Margin="12,0,0,0"
                    Click="StartEverything_Click" ToolTip="{StaticResource Tip.StartEverything}" />
            <Button x:Name="StopEverythingButton" Content="Stop everything"
                    Click="StopEverything_Click" ToolTip="{StaticResource Tip.StopEverything}" />
          </WrapPanel>
          <TextBlock Grid.Column="1" x:Name="StageText" VerticalAlignment="Center" Margin="10,0,0,0"
                     FontWeight="SemiBold" Text="Idle" TextWrapping="Wrap" />
        </Grid>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition /><RowDefinition /><RowDefinition />
          </Grid.RowDefinitions>

          <Label Grid.Row="0" Content="Card server" ToolTip="{StaticResource Tip.StartCard}" />
          <TextBlock Grid.Row="0" Grid.Column="1" x:Name="CardStatusText" VerticalAlignment="Center"
                     Text="Stopped" TextWrapping="Wrap" ToolTip="{StaticResource Tip.ComponentStatus}" />
          <Button Grid.Row="0" Grid.Column="2" x:Name="StartCardButton" Content="Start" Click="StartCard_Click"
                  ToolTip="{StaticResource Tip.StartCard}" />
          <Button Grid.Row="0" Grid.Column="3" x:Name="StopCardButton" Content="Stop" Click="StopCard_Click"
                  ToolTip="{StaticResource Tip.StopCard}" />

          <Label Grid.Row="1" Content="LM" ToolTip="{StaticResource Tip.StartLm}" />
          <TextBlock Grid.Row="1" Grid.Column="1" x:Name="LmStatusText" VerticalAlignment="Center"
                     Text="Stopped" TextWrapping="Wrap" ToolTip="{StaticResource Tip.ComponentStatus}" />
          <Button Grid.Row="1" Grid.Column="2" x:Name="StartLmButton" Content="Start" Click="StartLm_Click"
                  ToolTip="{StaticResource Tip.StartLm}" />
          <Button Grid.Row="1" Grid.Column="3" x:Name="StopLmButton" Content="Stop" Click="StopLm_Click"
                  ToolTip="{StaticResource Tip.StopLm}" />

          <Label Grid.Row="2" Content="Client" ToolTip="{StaticResource Tip.StartClient}" />
          <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ClientStatusText" VerticalAlignment="Center"
                     Text="Stopped" TextWrapping="Wrap" ToolTip="{StaticResource Tip.ComponentStatus}" />
          <Button Grid.Row="2" Grid.Column="2" x:Name="StartClientButton" Content="Start" Click="StartClient_Click"
                  ToolTip="{StaticResource Tip.StartClient}" />
          <Button Grid.Row="2" Grid.Column="3" x:Name="StopClientButton" Content="Stop" Click="StopClient_Click"
                  ToolTip="{StaticResource Tip.StopClient}" />
        </Grid>
      </StackPanel>
    </Border>

    <!-- Log stays visible under the tabs so start/stop output is always in view. -->
    <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0" Height="160">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Log" FontWeight="SemiBold" ToolTip="{StaticResource Tip.Log}" />
        <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" Margin="0,2,0,0" ToolTip="{StaticResource Tip.Log}" />
      </DockPanel>
    </Grid>

    <TabControl x:Name="MainTabs" Margin="0,8,0,0" SelectionChanged="MainTabs_SelectionChanged">
      <TabItem Header="Play" Tag="Play" ToolTip="{StaticResource Tip.TabPlay}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <GroupBox Header="Cab">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="140" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>
                <Label Grid.Row="0" Content="Cab name" ToolTip="{StaticResource Tip.Name}" />
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="NameBox" LostFocus="NameBox_LostFocus"
                         ToolTip="{StaticResource Tip.Name}" />

                <Label Grid.Row="1" Content="Game folder" ToolTip="{StaticResource Tip.GameFolder}" />
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="GameFolderBox" LostFocus="GameFolderBox_LostFocus"
                         ToolTip="{StaticResource Tip.GameFolder}" />
                <Button Grid.Row="1" Grid.Column="2" Content="Browse..." Click="BrowseGame_Click"
                        ToolTip="{StaticResource Tip.GameFolderBrowse}" />

                <Label Grid.Row="2" Content="Start" ToolTip="{StaticResource Tip.StartAll}" />
                <WrapPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2">
                  <CheckBox x:Name="StartServerCheck" Content="Card server" ToolTip="{StaticResource Tip.StartCardCheck}" />
                  <CheckBox x:Name="StartLmCheck" Content="LM (vsac29_Release_LM.exe)" ToolTip="{StaticResource Tip.StartLmCheck}" />
                  <CheckBox x:Name="StartClientCheck" Content="Client (vsac29_Release.exe)" ToolTip="{StaticResource Tip.StartClientCheck}" />
                </WrapPanel>
              </Grid>
            </GroupBox>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="All cabs" Tag="AllCabs" ToolTip="{StaticResource Tip.TabAllCabs}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <WrapPanel Margin="0,4,0,4">
              <Button Content="Start everything" FontWeight="Bold" Click="StartEverything_Click" ToolTip="{StaticResource Tip.StartEverything}" />
              <Button x:Name="CancelEverythingButton" Content="Cancel" IsEnabled="False" Click="CancelEverything_Click" ToolTip="{StaticResource Tip.Cancel}" />
              <Button Content="Stop everything" Click="StopEverything_Click" ToolTip="{StaticResource Tip.StopEverything}" />
              <Label Content="LM → first client (s)" Margin="12,0,0,0" ToolTip="{StaticResource Tip.EverythingLmDelay}" />
              <TextBox x:Name="EverythingLmDelayBox" Width="40" LostFocus="EverythingDelay_LostFocus" ToolTip="{StaticResource Tip.EverythingLmDelay}" />
              <Label Content="Between clients (s)" ToolTip="{StaticResource Tip.EverythingStagger}" />
              <TextBox x:Name="EverythingStaggerBox" Width="40" LostFocus="EverythingDelay_LostFocus" ToolTip="{StaticResource Tip.EverythingStagger}" />
            </WrapPanel>
            <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,4"
                       Text="Order: card servers (each one once, waits for its port) → LM → clients one at a time. Programs already running are left alone. CPU affinity and priority are never changed. ● green = running, amber = starting / waiting, red = failed, grey = off or not used." />
          </StackPanel>
          <TextBlock DockPanel.Dock="Bottom" x:Name="EverythingStatusText" TextWrapping="Wrap" Margin="0,4,0,0" FontWeight="SemiBold" />
          <ListView x:Name="CabsList" ToolTip="{StaticResource Tip.CabsList}">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="Include" Width="60">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate><CheckBox IsChecked="{Binding Include, Mode=TwoWay}" HorizontalAlignment="Center" /></DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="Cab" Width="130" DisplayMemberBinding="{Binding Name}" />
                <GridViewColumn Header="Card server" Width="95">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate><TextBlock Text="{Binding ServerText}" Foreground="{Binding ServerBrush}" FontWeight="SemiBold" /></DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="LM" Width="95">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate><TextBlock Text="{Binding LmText}" Foreground="{Binding LmBrush}" FontWeight="SemiBold" /></DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="Client" Width="95">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate><TextBlock Text="{Binding ClientText}" Foreground="{Binding ClientBrush}" FontWeight="SemiBold" /></DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="Window" Width="80" DisplayMemberBinding="{Binding Window}" />
                <GridViewColumn Header="Game folder" Width="260" DisplayMemberBinding="{Binding Folder}" />
              </GridView>
            </ListView.View>
          </ListView>
        </DockPanel>
      </TabItem>

      <TabItem Header="Card Server" Tag="CardServer" ToolTip="{StaticResource Tip.TabCardServer}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <GroupBox Header="Card server">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="140" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Content="Patched card server" ToolTip="{StaticResource Tip.CardServerPath}" />
                <StackPanel Grid.Row="0" Grid.Column="1">
                  <TextBox x:Name="ServerPathBox" LostFocus="ServerPathBox_LostFocus"
                           ToolTip="{StaticResource Tip.CardServerPath}" />
                  <TextBlock x:Name="ServerVersionText" Foreground="Gray" TextWrapping="Wrap" FontSize="11" Margin="0,2,0,0" />
                </StackPanel>
                <Button Grid.Row="0" Grid.Column="2" Content="Browse..." Click="BrowseServer_Click"
                        ToolTip="{StaticResource Tip.CardServerBrowse}" />

                <Label Grid.Row="1" Content="Server arguments" ToolTip="{StaticResource Tip.ServerArgs}" />
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="ServerArgsBox" ToolTip="{StaticResource Tip.ServerArgs}" />
                <Button Grid.Row="1" Grid.Column="2" Content="Card server..." Click="CardServerManager_Click"
                        ToolTip="{StaticResource Tip.CardServerManager}" />
              </Grid>
            </GroupBox>

            <GroupBox Header="Server settings">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="140" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Content="Card server address" ToolTip="{StaticResource Tip.CardServerHost}" />
                <WrapPanel Grid.Row="0" Grid.Column="1">
                  <TextBox x:Name="HostBox" Width="110" ToolTip="{StaticResource Tip.CardServerHost}" />
                  <TextBlock Text=":" VerticalAlignment="Center" Margin="0,0,6,0" />
                  <TextBox x:Name="PortBox" Width="60" ToolTip="{StaticResource Tip.CardServerPort}" />
                  <Label Content="wait up to (s)" Margin="10,0,0,0" ToolTip="{StaticResource Tip.PortTimeout}" />
                  <TextBox x:Name="TimeoutBox" Width="45" ToolTip="{StaticResource Tip.PortTimeout}" />
                  <Label Content="LM → client delay (s)" Margin="10,0,0,0" ToolTip="{StaticResource Tip.LmDelay}" />
                  <TextBox x:Name="DelayBox" Width="40" ToolTip="{StaticResource Tip.LmDelay}" />
                </WrapPanel>
                <Button Grid.Row="0" Grid.Column="2" Content="Open web page" Click="OpenWeb_Click"
                        ToolTip="{StaticResource Tip.OpenWeb}" />

                <Label Grid.Row="1" Content="Game Server=" ToolTip="{StaticResource Tip.GameServerIni}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="GameServerText"
                           VerticalAlignment="Center" TextWrapping="Wrap" ToolTip="{StaticResource Tip.GameServerIni}" />

                <Label Grid.Row="2" Content="Matchmaker" ToolTip="{StaticResource Tip.WizardMatchUrl}" />
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="MatchUrlBox" ToolTip="{StaticResource Tip.WizardMatchUrl}" />

                <Label Grid.Row="3" Content="Tag secret" ToolTip="{StaticResource Tip.WizardTagSecret}" />
                <StackPanel Grid.Row="3" Grid.Column="1">
                  <PasswordBox x:Name="TagSecretBox" ToolTip="{StaticResource Tip.WizardTagSecret}" Margin="0,2,6,2" />
                  <TextBlock x:Name="TagSecretStatusText" Foreground="Gray" TextWrapping="Wrap" FontSize="11" Margin="0,2,0,0"
                             ToolTip="{StaticResource Tip.WizardTagSecret}" />
                </StackPanel>
                <Button Grid.Row="3" Grid.Column="2" Content="Write server.json" Click="WriteServerJson_Click"
                        ToolTip="{StaticResource Tip.WriteServerJson}" />

                <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" x:Name="ServerJsonPathText"
                           Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,0"
                           ToolTip="{StaticResource Tip.WriteServerJson}" />
                <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" x:Name="WebUiUrlText"
                           TextWrapping="Wrap" Margin="0,2,0,0" ToolTip="{StaticResource Tip.OpenWeb}" />
              </Grid>
            </GroupBox>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Matchmaking" Tag="Matchmaking" ToolTip="{StaticResource Tip.TabMatchmaking}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <GroupBox Header="Matchmaking server">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="140" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>
                <Label Grid.Row="0" Content="Server" ToolTip="{StaticResource Tip.MatchmakerList}" />
                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="MatchmakerBox" DisplayMemberPath="Display" Margin="0,2,6,2"
                          SelectionChanged="MatchmakerBox_SelectionChanged" ToolTip="{StaticResource Tip.MatchmakerList}" />
                <Button Grid.Row="0" Grid.Column="2" Content="Use for this card server" FontWeight="SemiBold"
                        Click="UseMatchmaker_Click" ToolTip="{StaticResource Tip.UseMatchmaker}" />
                <Button Grid.Row="0" Grid.Column="3" Content="Edit list..." Click="EditMatchmakers_Click"
                        ToolTip="{StaticResource Tip.EditMatchmakers}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" x:Name="MatchmakerStatusText" Foreground="Gray"
                           TextWrapping="Wrap" FontSize="11" Margin="0,2,0,0" ToolTip="{StaticResource Tip.MatchmakerList}" />
              </Grid>
            </GroupBox>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Cab" Tag="Cab" ToolTip="{StaticResource Tip.TabCab}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <GroupBox Header="Cab identity">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="140" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>
                <Label Grid.Row="0" Content="Folder / window" ToolTip="{StaticResource Tip.CabMapping}" />
                <TextBlock Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" x:Name="CabMappingText"
                           VerticalAlignment="Center" TextWrapping="Wrap" ToolTip="{StaticResource Tip.CabMapping}" />

                <Label Grid.Row="1" Content="Serial (config.ini)" ToolTip="{StaticResource Tip.Serial}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="SerialText" VerticalAlignment="Center" FontFamily="Consolas"
                           TextWrapping="Wrap" ToolTip="{StaticResource Tip.Serial}" />
                <Button Grid.Row="1" Grid.Column="3" Content="New serial" Click="NewSerial_Click"
                        ToolTip="{StaticResource Tip.NewSerial}" />

                <Label Grid.Row="2" Content="Card (card.ini)" ToolTip="{StaticResource Tip.Card}" />
                <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" x:Name="CardText" VerticalAlignment="Center"
                           TextWrapping="Wrap" ToolTip="{StaticResource Tip.Card}" />
                <Button Grid.Row="2" Grid.Column="3" Content="New card" Click="NewCard_Click"
                        ToolTip="{StaticResource Tip.NewCard}" />

                <Label Grid.Row="3" Content="Access code prefix" ToolTip="{StaticResource Tip.AccessPrefix}" />
                <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal">
                  <TextBox x:Name="PrefixBox" Width="60" ToolTip="{StaticResource Tip.AccessPrefix}" />
                  <TextBlock Text="optional, e.g. 99" Foreground="Gray" VerticalAlignment="Center"
                             ToolTip="{StaticResource Tip.AccessPrefix}" />
                </StackPanel>

                <Label Grid.Row="4" Content="Controls" ToolTip="{StaticResource Tip.Controllers}" />
                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="ControllerSummaryText" VerticalAlignment="Center"
                           TextWrapping="Wrap" ToolTip="{StaticResource Tip.Controllers}" />
                <Button Grid.Row="4" Grid.Column="2" Content="Controllers..." Click="Controllers_Click"
                        ToolTip="{StaticResource Tip.Controllers}" />
                <Button Grid.Row="4" Grid.Column="3" Content="Keyboard..." Click="Keyboard_Click"
                        ToolTip="{StaticResource Tip.Keyboard}" />

                <CheckBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" x:Name="SyncSnowCheck"
                          ToolTip="{StaticResource Tip.SyncSnow}">
                  <TextBlock TextWrapping="Wrap"
                             Text="Also update SnowLauncher.ini if it exists (so SnowLauncher won't put old values back)" />
                </CheckBox>
              </Grid>
            </GroupBox>

            <GroupBox Header="Graphics and resolution" x:Name="GraphicsBox">
              <StackPanel>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="Client (config.ini) and LM (lmnfig.ini) resolutions are stored separately. A typical 4-cab layout is LM at 144p and each client at 480p. Files are backed up before they change. Close the game and LM first so they reread the values." />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" MinWidth="140" />
                    <ColumnDefinition Width="*" MinWidth="140" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Label Grid.Row="0" Grid.Column="1" Content="Client" ToolTip="{StaticResource Tip.GraphicsClient}" />
                  <Label Grid.Row="0" Grid.Column="2" Content="LM" ToolTip="{StaticResource Tip.GraphicsLm}" />

                  <Label Grid.Row="1" Content="Resolution" ToolTip="{StaticResource Tip.GraphicsResolution}" />
                  <ComboBox Grid.Row="1" Grid.Column="1" x:Name="ClientResolutionBox" IsEditable="True" Margin="0,2,6,2"
                            ToolTip="{StaticResource Tip.GraphicsResolution}" />
                  <ComboBox Grid.Row="1" Grid.Column="2" x:Name="LmResolutionBox" IsEditable="True" Margin="0,2,6,2"
                            ToolTip="{StaticResource Tip.GraphicsResolution}" />

                  <Label Grid.Row="2" Content="Windowed" ToolTip="{StaticResource Tip.GraphicsWindowed}" />
                  <CheckBox Grid.Row="2" Grid.Column="1" x:Name="ClientWindowedCheck" IsThreeState="True"
                            Content="Windowed" VerticalAlignment="Center" ToolTip="{StaticResource Tip.GraphicsWindowed}" />
                  <CheckBox Grid.Row="2" Grid.Column="2" x:Name="LmWindowedCheck" IsThreeState="True"
                            Content="Windowed" VerticalAlignment="Center" ToolTip="{StaticResource Tip.GraphicsWindowed}" />

                  <Label Grid.Row="3" Content="Borderless" ToolTip="{StaticResource Tip.GraphicsBorderless}" />
                  <CheckBox Grid.Row="3" Grid.Column="1" x:Name="ClientBorderlessCheck" IsThreeState="True"
                            Content="Borderless window" VerticalAlignment="Center" ToolTip="{StaticResource Tip.GraphicsBorderless}" />
                  <CheckBox Grid.Row="3" Grid.Column="2" x:Name="LmBorderlessCheck" IsThreeState="True"
                            Content="Borderless window" VerticalAlignment="Center" ToolTip="{StaticResource Tip.GraphicsBorderless}" />

                  <Label Grid.Row="4" Content="Framerate limit" ToolTip="{StaticResource Tip.GraphicsFramerate}" />
                  <CheckBox Grid.Row="4" Grid.Column="1" x:Name="ClientFramerateCheck" IsThreeState="True"
                            Content="FramerateLimit" VerticalAlignment="Center" ToolTip="{StaticResource Tip.GraphicsFramerate}" />
                  <CheckBox Grid.Row="4" Grid.Column="2" x:Name="LmFramerateCheck" IsThreeState="True"
                            Content="FramerateLimit" VerticalAlignment="Center" ToolTip="{StaticResource Tip.GraphicsFramerate}" />

                  <Label Grid.Row="5" Content="Opening skip" ToolTip="{StaticResource Tip.GraphicsOpening}" />
                  <ComboBox Grid.Row="5" Grid.Column="1" x:Name="ClientOpeningBox" IsEditable="True" Margin="0,2,6,2"
                            ToolTip="{StaticResource Tip.GraphicsOpening}" />
                  <ComboBox Grid.Row="5" Grid.Column="2" x:Name="LmOpeningBox" IsEditable="True" Margin="0,2,6,2"
                            ToolTip="{StaticResource Tip.GraphicsOpening}" />
                </Grid>
                <WrapPanel Margin="0,8,0,0">
                  <Button Content="Reload graphics" Click="ReloadGraphics_Click" ToolTip="{StaticResource Tip.GraphicsReload}" />
                  <Button Content="Write graphics" FontWeight="Bold" Click="WriteGraphics_Click" ToolTip="{StaticResource Tip.GraphicsWrite}" />
                </WrapPanel>
                <TextBlock x:Name="GraphicsStatusText" TextWrapping="Wrap" Margin="0,6,0,0" />
              </StackPanel>
            </GroupBox>

            <GroupBox Header="Network (PCB / LM IP)">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="140" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>
                <CheckBox Grid.Row="0" Grid.Column="1" x:Name="AutoIpCheck"
                          ToolTip="{StaticResource Tip.AutoDetectIp}">
                  <TextBlock TextWrapping="Wrap"
                             Text="Detect this PC's LAN IP for the PCB (client) on every Start" />
                </CheckBox>
                <Button Grid.Row="0" Grid.Column="2" Content="Detect now" Click="DetectIp_Click"
                        ToolTip="{StaticResource Tip.DetectNow}" />

                <Label Grid.Row="1" Content="PCB (client) IP" ToolTip="{StaticResource Tip.PcbIp}" />
                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="PcbIpBox" IsEditable="True" Margin="0,2,6,2"
                          ToolTip="{StaticResource Tip.PcbIp}" />

                <Label Grid.Row="2" Content="LM IP" ToolTip="{StaticResource Tip.LmIp}" />
                <ComboBox Grid.Row="2" Grid.Column="1" x:Name="LmIpBox" IsEditable="True" Margin="0,2,6,2"
                          ToolTip="{StaticResource Tip.LmIp}" />
                <Button Grid.Row="2" Grid.Column="2" Content="Write IPs" Click="WriteIps_Click"
                        ToolTip="{StaticResource Tip.WriteIps}" />

                <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" x:Name="CurrentIpText"
                           TextWrapping="Wrap" Margin="0,6,0,0"
                           ToolTip="{StaticResource Tip.CurrentIps}" />
              </Grid>
            </GroupBox>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Health" Tag="Health" ToolTip="{StaticResource Tip.TabHealth}">
        <DockPanel>
          <WrapPanel DockPanel.Dock="Top" Margin="0,4,0,4">
            <CheckBox x:Name="HealthImportantOnly" Content="Problems only" Margin="0,0,12,0" VerticalAlignment="Center"
                      Checked="HealthFilter_Changed" Unchecked="HealthFilter_Changed" ToolTip="{StaticResource Tip.HealthImportant}" />
            <Button Content="Open saved event" Click="HealthOpenEvent_Click" ToolTip="{StaticResource Tip.HealthOpen}" />
            <Button Content="Open events folder" Click="HealthOpenFolder_Click" ToolTip="{StaticResource Tip.HealthFolder}" />
            <Button Content="Clear list" Click="HealthClear_Click" />
          </WrapPanel>
          <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,4"
                     Text="Watches each profile's card server, LM and client (by its own folder) and the card server log. Read-only: it never touches a running program. Problems are saved with the log lines around them (masked) so you can share them." />
          <TextBlock DockPanel.Dock="Bottom" x:Name="HealthStatusText" Foreground="Gray" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
          <ListView x:Name="HealthList" MouseDoubleClick="HealthOpenEvent_Click">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="Time" Width="70" DisplayMemberBinding="{Binding At, StringFormat=HH:mm:ss}" />
                <GridViewColumn Header="Cab" Width="110" DisplayMemberBinding="{Binding Cab}" />
                <GridViewColumn Header="Source" Width="100" DisplayMemberBinding="{Binding Source}" />
                <GridViewColumn Header="Event" Width="130" DisplayMemberBinding="{Binding KindLabel}" />
                <GridViewColumn Header="Detail" Width="420" DisplayMemberBinding="{Binding Message}" />
              </GridView>
            </ListView.View>
          </ListView>
        </DockPanel>
      </TabItem>

      <TabItem Header="Cards" Tag="Cards" ToolTip="{StaticResource Tip.TabCards}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <GroupBox Header="This cab's card">
              <StackPanel>
                <WrapPanel>
                  <Button Content="Load card stats" Click="LoadMyCard_Click" ToolTip="{StaticResource Tip.MyCard}" />
                  <Button Content="Back up card.ini" Click="BackupCard_Click" ToolTip="{StaticResource Tip.CardBackup}" />
                  <ComboBox x:Name="CardBackupsBox" Width="280" DisplayMemberPath="Label" Margin="6,2" ToolTip="{StaticResource Tip.CardRestore}" />
                  <Button Content="Restore selected..." Click="RestoreCard_Click" ToolTip="{StaticResource Tip.CardRestore}" />
                  <Button Content="Open backups folder" Click="OpenCardBackups_Click" />
                </WrapPanel>
                <TextBlock x:Name="MyCardText" TextWrapping="Wrap" Margin="0,4,0,0" />
              </StackPanel>
            </GroupBox>
            <GroupBox Header="Cards on this card server">
              <StackPanel>
                <WrapPanel>
                  <TextBox x:Name="CardSearchBox" Width="180" ToolTip="{StaticResource Tip.CardSearch}" />
                  <Button Content="Refresh" Click="RefreshCards_Click" ToolTip="{StaticResource Tip.CardList}" />
                  <TextBlock x:Name="CardsStatusText" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray" TextWrapping="Wrap" />
                </WrapPanel>
                <ListView x:Name="CardsList" Height="220" Margin="0,4,0,0">
                  <ListView.View>
                    <GridView>
                      <GridViewColumn Header="#" Width="50" DisplayMemberBinding="{Binding CardId}" />
                      <GridViewColumn Header="Name" Width="200" DisplayMemberBinding="{Binding UserName}" />
                      <GridViewColumn Header="Chip id (masked)" Width="140" DisplayMemberBinding="{Binding MaskedId}" />
                    </GridView>
                  </ListView.View>
                </ListView>
                <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,4,0,0"
                           Text="Read from the card server's own web API; nothing is written to its database. Card ids are masked (the server only gives a short hint). Play count and last played are shown for this cab's card above, because the server needs the card's keys for that." />
              </StackPanel>
            </GroupBox>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Stats" Tag="Stats" ToolTip="{StaticResource Tip.TabStats}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <GroupBox Header="Global leaderboard">
              <StackPanel>
                <WrapPanel>
                  <ComboBox x:Name="BoardBox" Width="140" Margin="0,2,6,2" />
                  <Button Content="Refresh" Click="RefreshBoard_Click" ToolTip="{StaticResource Tip.Leaderboard}" />
                  <TextBlock x:Name="BoardStatusText" VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="Wrap" />
                </WrapPanel>
                <ListView x:Name="BoardList" Height="240" Margin="0,4,0,0">
                  <ListView.View>
                    <GridView>
                      <GridViewColumn Header="Rank" Width="50" DisplayMemberBinding="{Binding Rank}" />
                      <GridViewColumn Header="Name" Width="160" DisplayMemberBinding="{Binding DisplayName}" />
                      <GridViewColumn Header="Class" Width="80" DisplayMemberBinding="{Binding ClassName}" />
                      <GridViewColumn Header="Grade" Width="50" DisplayMemberBinding="{Binding Grade}" />
                      <GridViewColumn Header="Rate" Width="70" DisplayMemberBinding="{Binding Rate, StringFormat=0.0}" />
                      <GridViewColumn Header="W" Width="45" DisplayMemberBinding="{Binding Wins}" />
                      <GridViewColumn Header="L" Width="45" DisplayMemberBinding="{Binding Losses}" />
                      <GridViewColumn Header="Matches" Width="60" DisplayMemberBinding="{Binding Matches}" />
                      <GridViewColumn Header="Win %" Width="60" DisplayMemberBinding="{Binding WinRate, StringFormat=0.0}" />
                    </GridView>
                  </ListView.View>
                </ListView>
              </StackPanel>
            </GroupBox>
            <GroupBox Header="This cab's recent matches">
              <StackPanel>
                <WrapPanel>
                  <Button Content="Load recent matches" Click="LoadHistory_Click" ToolTip="{StaticResource Tip.History}" />
                  <TextBlock x:Name="HistoryStatusText" VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="Wrap" />
                </WrapPanel>
                <ListView x:Name="HistoryList" Height="200" Margin="0,4,0,0">
                  <ListView.View>
                    <GridView>
                      <GridViewColumn Header="When" Width="120" DisplayMemberBinding="{Binding When}" />
                      <GridViewColumn Header="Result" Width="55" DisplayMemberBinding="{Binding Result}" />
                      <GridViewColumn Header="Suit id" Width="55" DisplayMemberBinding="{Binding SuitId}" />
                      <GridViewColumn Header="Time" Width="50" DisplayMemberBinding="{Binding Duration}" />
                      <GridViewColumn Header="Score" Width="60" DisplayMemberBinding="{Binding Score}" />
                      <GridViewColumn Header="Players" Width="320" DisplayMemberBinding="{Binding Players}" />
                    </GridView>
                  </ListView.View>
                </ListView>
              </StackPanel>
            </GroupBox>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Settings" Tag="Settings" ToolTip="{StaticResource Tip.TabSettings}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <GroupBox Header="Launcher updates">
              <StackPanel>
                <TextBlock x:Name="UpdateVersionText" Margin="0,0,0,4" />
                <CheckBox x:Name="UpdateOnStartupCheck" Content="Check for updates when the launcher starts (only tells you; never installs by itself)"
                          Click="SettingsCheck_Click" ToolTip="{StaticResource Tip.UpdateOnStartup}" />
                <CheckBox x:Name="UpdatePreCheck" Content="Include pre-releases" Click="SettingsCheck_Click" ToolTip="{StaticResource Tip.UpdatePre}" />
                <WrapPanel Margin="0,4,0,0">
                  <Button Content="Check now" Click="CheckUpdate_Click" />
                  <Button x:Name="InstallUpdateButton" Content="Download and install" IsEnabled="False" Click="InstallUpdate_Click" ToolTip="{StaticResource Tip.UpdateInstall}" />
                  <Button x:Name="SkipUpdateButton" Content="Skip this version" IsEnabled="False" Click="SkipUpdate_Click" />
                  <Button x:Name="RollbackButton" Content="Go back to previous version" Click="Rollback_Click" ToolTip="{StaticResource Tip.UpdateRollback}" />
                  <Button Content="Releases page" Click="OpenReleases_Click" />
                </WrapPanel>
                <TextBlock x:Name="UpdateStatusText" TextWrapping="Wrap" Margin="0,4,0,0" />
              </StackPanel>
            </GroupBox>
            <GroupBox Header="Discord Rich Presence">
              <StackPanel>
                <CheckBox x:Name="PresenceCheck" Content="Show EXVS2 IB status on my Discord profile" Click="PresenceSettings_Changed" ToolTip="{StaticResource Tip.Presence}" />
                <WrapPanel Margin="0,2,0,0">
                  <Label Content="Discord application id" ToolTip="{StaticResource Tip.PresenceId}" />
                  <TextBox x:Name="PresenceIdBox" Width="200" LostFocus="PresenceSettings_Changed" ToolTip="{StaticResource Tip.PresenceId}" />
                  <CheckBox x:Name="PresenceButtonCheck" Content="Show a &quot;Join the EXVS2 Discord&quot; button" VerticalAlignment="Center" Margin="8,0,0,0" Click="PresenceSettings_Changed" />
                  <Button Content="Test" Click="PresenceTest_Click" />
                  <Button Content="How to get an id" Click="PresenceHelp_Click" />
                </WrapPanel>
                <TextBlock x:Name="PresenceStatusText" TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,2,0,0" />
              </StackPanel>
            </GroupBox>
            <GroupBox Header="Queue and match notifications">
              <StackPanel>
                <WrapPanel>
                  <CheckBox x:Name="NotifySoundCheck" Content="Play a sound" Margin="0,0,12,0" Click="SettingsCheck_Click" />
                  <CheckBox x:Name="NotifyToastCheck" Content="Show a Windows notification" Margin="0,0,12,0" Click="SettingsCheck_Click" />
                  <Button Content="Test" Click="NotifyTest_Click" />
                </WrapPanel>
                <WrapPanel Margin="0,2,0,0">
                  <CheckBox x:Name="NotifyQueueCheck" Content="When someone starts searching on the selected matchmaker" Margin="0,0,12,0" Click="SettingsCheck_Click" />
                  <CheckBox x:Name="NotifyMatchCheck" Content="When a match starts (matchmaker or this PC's card server log)" Click="SettingsCheck_Click" />
                </WrapPanel>
                <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,2,0,0" ToolTip="{StaticResource Tip.Notify}"
                           Text="Off by default. Uses the selected server's player counts (checked every 15 s) and the local card server log. Nothing fires when the launcher first opens." />
              </StackPanel>
            </GroupBox>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
