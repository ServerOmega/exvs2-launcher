<Window x:Class="Exvs2Launcher.App.MatchmakingServersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Matchmaking servers" Width="600" Height="460" MinWidth="480" MinHeight="380"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="12">
    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
               Text="Saved matchmaking servers for the dropdown. Only a name, host and port are stored (in the launcher's profile file). The public matchmaker port is 28090. The LA and EU entries start without an address: ask in the Discord for them." />
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Content="Save" IsDefault="True" MinWidth="90" Click="Ok_Click" />
      <Button Content="Cancel" IsCancel="True" MinWidth="90" Margin="6,0,0,0" />
    </StackPanel>
    <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="80" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="80" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
      </Grid.RowDefinitions>
      <Label Grid.Row="0" Content="Name" />
      <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" x:Name="NameBox" Margin="0,2" />
      <Label Grid.Row="1" Content="Host" />
      <TextBox Grid.Row="1" Grid.Column="1" x:Name="HostBox" Margin="0,2"
               ToolTip="Host name or IP of the matchmaker (no http://, no path). You can also paste a full http://host:28090/match address." />
      <Label Grid.Row="1" Grid.Column="2" Content="Port" />
      <TextBox Grid.Row="1" Grid.Column="3" x:Name="PortBox" Margin="0,2" Text="28090" />
      <WrapPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,4,0,0">
        <Button Content="Add as new" Click="Add_Click" />
        <Button Content="Update selected" Click="Update_Click" Margin="6,0,0,0" />
        <Button Content="Remove selected" Click="Remove_Click" Margin="6,0,0,0" />
        <Button Content="Add LA / EU placeholders" Click="Defaults_Click" Margin="6,0,0,0" />
      </WrapPanel>
      <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" x:Name="ErrorText" Foreground="DarkRed" TextWrapping="Wrap" Margin="0,4,0,0" />
    </Grid>
    <ListView x:Name="List" SelectionChanged="List_SelectionChanged">
      <ListView.View>
        <GridView>
          <GridViewColumn Header="Name" Width="200" DisplayMemberBinding="{Binding Name}" />
          <GridViewColumn Header="Host" Width="220" DisplayMemberBinding="{Binding Host}" />
          <GridViewColumn Header="Port" Width="70" DisplayMemberBinding="{Binding Port}" />
        </GridView>
      </ListView.View>
    </ListView>
  </DockPanel>
</Window>
