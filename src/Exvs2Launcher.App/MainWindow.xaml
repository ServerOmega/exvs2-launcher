<Window x:Class="Exvs2Launcher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EXVS2 Launcher" Width="940" Height="960" MinWidth="780" MinHeight="700"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing"
        ToolTipService.InitialShowDelay="700"
        ToolTipService.ShowDuration="30000"
        ToolTipService.BetweenShowDelay="200">
  <DockPanel Margin="10">
    <!-- Profile bar -->
    <DockPanel DockPanel.Dock="Top">
      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
        <Label Content="Cab profile:" ToolTip="{StaticResource Tip.Profile}" />
        <ComboBox x:Name="ProfileBox" Width="260" Margin="0,0,6,0" DisplayMemberPath="Name"
                  SelectionChanged="ProfileBox_SelectionChanged" ToolTip="{StaticResource Tip.Profile}" />
        <Button Content="New" Click="NewProfile_Click" ToolTip="{StaticResource Tip.ProfileNew}" />
        <Button Content="Delete" Click="DeleteProfile_Click" ToolTip="{StaticResource Tip.ProfileDelete}" />
        <Button Content="Save" Click="Save_Click" ToolTip="{StaticResource Tip.ProfileSave}" />
        <Button Content="Troubleshooting" Click="Troubleshooting_Click" ToolTip="{StaticResource Tip.Troubleshooting}" />
      </StackPanel>
      <TextBlock x:Name="StoreText" VerticalAlignment="Center" Foreground="Gray" Margin="6,0,0,0"
                 TextWrapping="Wrap" ToolTip="{StaticResource Tip.ProfileStore}" />
    </DockPanel>

    <!-- Start / stop bar -->
    <Border DockPanel.Dock="Top" Margin="0,8,0,0" Padding="8" Background="#FFF3F6FA" BorderBrush="#FFCBD5E1" BorderThickness="1" CornerRadius="3">
      <StackPanel>
        <Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <WrapPanel>
            <Button x:Name="StartButton" Content="Start all" FontWeight="Bold" MinWidth="100"
                    Click="Start_Click" ToolTip="{StaticResource Tip.StartAll}" />
            <Button x:Name="CancelButton" Content="Cancel" IsEnabled="False" Click="Cancel_Click"
                    ToolTip="{StaticResource Tip.Cancel}" />
            <Button x:Name="StopAllButton" Content="Stop all" Click="StopAll_Click"
                    ToolTip="{StaticResource Tip.StopAll}" />
            <Button Content="Check port" Click="CheckPort_Click" ToolTip="{StaticResource Tip.CheckPort}" />
            <Button Content="Open web page" Click="OpenWeb_Click" ToolTip="{StaticResource Tip.OpenWeb}" />
            <Button Content="Controllers..." Click="Controllers_Click" ToolTip="{StaticResource Tip.Controllers}" />
            <Button Content="Keyboard..." Click="Keyboard_Click" ToolTip="{StaticResource Tip.Keyboard}" />
          </WrapPanel>
          <TextBlock Grid.Column="1" x:Name="StageText" VerticalAlignment="Center" Margin="10,0,0,0"
                     FontWeight="SemiBold" Text="Idle" TextWrapping="Wrap" />
        </Grid>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition /><RowDefinition /><RowDefinition />
          </Grid.RowDefinitions>

          <Label Grid.Row="0" Content="Card server" ToolTip="{StaticResource Tip.StartCard}" />
          <TextBlock Grid.Row="0" Grid.Column="1" x:Name="CardStatusText" VerticalAlignment="Center"
                     Text="Stopped" TextWrapping="Wrap" ToolTip="{StaticResource Tip.ComponentStatus}" />
          <Button Grid.Row="0" Grid.Column="2" x:Name="StartCardButton" Content="Start" Click="StartCard_Click"
                  ToolTip="{StaticResource Tip.StartCard}" />
          <Button Grid.Row="0" Grid.Column="3" x:Name="StopCardButton" Content="Stop" Click="StopCard_Click"
                  ToolTip="{StaticResource Tip.StopCard}" />

          <Label Grid.Row="1" Content="LM" ToolTip="{StaticResource Tip.StartLm}" />
          <TextBlock Grid.Row="1" Grid.Column="1" x:Name="LmStatusText" VerticalAlignment="Center"
                     Text="Stopped" TextWrapping="Wrap" ToolTip="{StaticResource Tip.ComponentStatus}" />
          <Button Grid.Row="1" Grid.Column="2" x:Name="StartLmButton" Content="Start" Click="StartLm_Click"
                  ToolTip="{StaticResource Tip.StartLm}" />
          <Button Grid.Row="1" Grid.Column="3" x:Name="StopLmButton" Content="Stop" Click="StopLm_Click"
                  ToolTip="{StaticResource Tip.StopLm}" />

          <Label Grid.Row="2" Content="Client" ToolTip="{StaticResource Tip.StartClient}" />
          <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ClientStatusText" VerticalAlignment="Center"
                     Text="Stopped" TextWrapping="Wrap" ToolTip="{StaticResource Tip.ComponentStatus}" />
          <Button Grid.Row="2" Grid.Column="2" x:Name="StartClientButton" Content="Start" Click="StartClient_Click"
                  ToolTip="{StaticResource Tip.StartClient}" />
          <Button Grid.Row="2" Grid.Column="3" x:Name="StopClientButton" Content="Stop" Click="StopClient_Click"
                  ToolTip="{StaticResource Tip.StopClient}" />
        </Grid>
      </StackPanel>
    </Border>

    <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto" MaxHeight="560">
      <StackPanel>
        <GroupBox Header="Cab">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="140" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
            </Grid.RowDefinitions>
            <Label Grid.Row="0" Content="Cab name" ToolTip="{StaticResource Tip.Name}" />
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="NameBox" LostFocus="NameBox_LostFocus"
                     ToolTip="{StaticResource Tip.Name}" />

            <Label Grid.Row="1" Content="Game folder" ToolTip="{StaticResource Tip.GameFolder}" />
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="GameFolderBox" LostFocus="GameFolderBox_LostFocus"
                     ToolTip="{StaticResource Tip.GameFolder}" />
            <Button Grid.Row="1" Grid.Column="2" Content="Browse..." Click="BrowseGame_Click"
                    ToolTip="{StaticResource Tip.GameFolderBrowse}" />

            <Label Grid.Row="2" Content="Patched card server" ToolTip="{StaticResource Tip.CardServerPath}" />
            <StackPanel Grid.Row="2" Grid.Column="1">
              <TextBox x:Name="ServerPathBox" LostFocus="ServerPathBox_LostFocus"
                       ToolTip="{StaticResource Tip.CardServerPath}" />
              <TextBlock x:Name="ServerVersionText" Foreground="Gray" TextWrapping="Wrap" FontSize="11" Margin="0,2,0,0" />
            </StackPanel>
            <Button Grid.Row="2" Grid.Column="2" Content="Browse..." Click="BrowseServer_Click"
                    ToolTip="{StaticResource Tip.CardServerBrowse}" />

            <Label Grid.Row="3" Content="Server arguments" ToolTip="{StaticResource Tip.ServerArgs}" />
            <TextBox Grid.Row="3" Grid.Column="1" x:Name="ServerArgsBox" ToolTip="{StaticResource Tip.ServerArgs}" />

            <Label Grid.Row="4" Content="Start" ToolTip="{StaticResource Tip.StartAll}" />
            <WrapPanel Grid.Row="4" Grid.Column="1">
              <CheckBox x:Name="StartServerCheck" Content="Card server" ToolTip="{StaticResource Tip.StartCardCheck}" />
              <CheckBox x:Name="StartLmCheck" Content="LM (vsac29_Release_LM.exe)" ToolTip="{StaticResource Tip.StartLmCheck}" />
              <CheckBox x:Name="StartClientCheck" Content="Client (vsac29_Release.exe)" ToolTip="{StaticResource Tip.StartClientCheck}" />
            </WrapPanel>
          </Grid>
        </GroupBox>

        <GroupBox Header="Cab identity">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="140" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
            </Grid.RowDefinitions>
            <Label Grid.Row="0" Content="Folder / window" ToolTip="{StaticResource Tip.CabMapping}" />
            <TextBlock Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" x:Name="CabMappingText"
                       VerticalAlignment="Center" TextWrapping="Wrap" ToolTip="{StaticResource Tip.CabMapping}" />

            <Label Grid.Row="1" Content="Serial (config.ini)" ToolTip="{StaticResource Tip.Serial}" />
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SerialText" VerticalAlignment="Center" FontFamily="Consolas"
                       TextWrapping="Wrap" ToolTip="{StaticResource Tip.Serial}" />
            <Button Grid.Row="1" Grid.Column="2" Content="New serial" Click="NewSerial_Click"
                    ToolTip="{StaticResource Tip.NewSerial}" />

            <Label Grid.Row="2" Content="Card (card.ini)" ToolTip="{StaticResource Tip.Card}" />
            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="CardText" VerticalAlignment="Center"
                       TextWrapping="Wrap" ToolTip="{StaticResource Tip.Card}" />
            <Button Grid.Row="2" Grid.Column="2" Content="New card" Click="NewCard_Click"
                    ToolTip="{StaticResource Tip.NewCard}" />

            <Label Grid.Row="3" Content="Access code prefix" ToolTip="{StaticResource Tip.AccessPrefix}" />
            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
              <TextBox x:Name="PrefixBox" Width="60" ToolTip="{StaticResource Tip.AccessPrefix}" />
              <TextBlock Text="optional, e.g. 99" Foreground="Gray" VerticalAlignment="Center"
                         ToolTip="{StaticResource Tip.AccessPrefix}" />
            </StackPanel>

            <Label Grid.Row="4" Content="Controller" ToolTip="{StaticResource Tip.Controllers}" />
            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="ControllerSummaryText" VerticalAlignment="Center"
                       TextWrapping="Wrap" ToolTip="{StaticResource Tip.Controllers}" />
            <Button Grid.Row="4" Grid.Column="2" Content="Controllers..." Click="Controllers_Click"
                    ToolTip="{StaticResource Tip.Controllers}" />

            <CheckBox Grid.Row="5" Grid.Column="1" x:Name="SyncSnowCheck"
                      ToolTip="{StaticResource Tip.SyncSnow}">
              <TextBlock TextWrapping="Wrap"
                         Text="Also update SnowLauncher.ini if it exists (so SnowLauncher won't put old values back)" />
            </CheckBox>
          </Grid>
        </GroupBox>

        <GroupBox Header="Graphics and resolution" x:Name="GraphicsBox">
          <StackPanel>
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                       Text="Client (config.ini) and LM (lmnfig.ini) resolutions are stored separately. A typical 4-cab layout is LM at 144p and each client at 480p. Files are backed up before they change. Close the game and LM first so they reread the values." />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" MinWidth="140" />
                <ColumnDefinition Width="*" MinWidth="140" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Label Grid.Row="0" Grid.Column="1" Content="Client" ToolTip="{StaticResource Tip.GraphicsClient}" />
              <Label Grid.Row="0" Grid.Column="2" Content="LM" ToolTip="{StaticResource Tip.GraphicsLm}" />

              <Label Grid.Row="1" Content="Resolution" ToolTip="{StaticResource Tip.GraphicsResolution}" />
              <ComboBox Grid.Row="1" Grid.Column="1" x:Name="ClientResolutionBox" IsEditable="True" Margin="0,2,6,2"
                        ToolTip="{StaticResource Tip.GraphicsResolution}" />
              <ComboBox Grid.Row="1" Grid.Column="2" x:Name="LmResolutionBox" IsEditable="True" Margin="0,2,6,2"
                        ToolTip="{StaticResource Tip.GraphicsResolution}" />

              <Label Grid.Row="2" Content="Windowed" ToolTip="{StaticResource Tip.GraphicsWindowed}" />
              <CheckBox Grid.Row="2" Grid.Column="1" x:Name="ClientWindowedCheck" IsThreeState="True"
                        Content="Windowed" VerticalAlignment="Center" ToolTip="{StaticResource Tip.GraphicsWindowed}" />
              <CheckBox Grid.Row="2" Grid.Column="2" x:Name="LmWindowedCheck" IsThreeState="True"
                        Content="Windowed" VerticalAlignment="Center" ToolTip="{StaticResource Tip.GraphicsWindowed}" />

              <Label Grid.Row="3" Content="Borderless" ToolTip="{StaticResource Tip.GraphicsBorderless}" />
              <CheckBox Grid.Row="3" Grid.Column="1" x:Name="ClientBorderlessCheck" IsThreeState="True"
                        Content="Borderless window" VerticalAlignment="Center" ToolTip="{StaticResource Tip.GraphicsBorderless}" />
              <CheckBox Grid.Row="3" Grid.Column="2" x:Name="LmBorderlessCheck" IsThreeState="True"
                        Content="Borderless window" VerticalAlignment="Center" ToolTip="{StaticResource Tip.GraphicsBorderless}" />

              <Label Grid.Row="4" Content="Framerate limit" ToolTip="{StaticResource Tip.GraphicsFramerate}" />
              <CheckBox Grid.Row="4" Grid.Column="1" x:Name="ClientFramerateCheck" IsThreeState="True"
                        Content="FramerateLimit" VerticalAlignment="Center" ToolTip="{StaticResource Tip.GraphicsFramerate}" />
              <CheckBox Grid.Row="4" Grid.Column="2" x:Name="LmFramerateCheck" IsThreeState="True"
                        Content="FramerateLimit" VerticalAlignment="Center" ToolTip="{StaticResource Tip.GraphicsFramerate}" />

              <Label Grid.Row="5" Content="Opening skip" ToolTip="{StaticResource Tip.GraphicsOpening}" />
              <ComboBox Grid.Row="5" Grid.Column="1" x:Name="ClientOpeningBox" IsEditable="True" Margin="0,2,6,2"
                        ToolTip="{StaticResource Tip.GraphicsOpening}" />
              <ComboBox Grid.Row="5" Grid.Column="2" x:Name="LmOpeningBox" IsEditable="True" Margin="0,2,6,2"
                        ToolTip="{StaticResource Tip.GraphicsOpening}" />
            </Grid>
            <WrapPanel Margin="0,8,0,0">
              <Button Content="Reload graphics" Click="ReloadGraphics_Click" ToolTip="{StaticResource Tip.GraphicsReload}" />
              <Button Content="Write graphics" FontWeight="Bold" Click="WriteGraphics_Click" ToolTip="{StaticResource Tip.GraphicsWrite}" />
            </WrapPanel>
            <TextBlock x:Name="GraphicsStatusText" TextWrapping="Wrap" Margin="0,6,0,0" />
          </StackPanel>
        </GroupBox>

        <GroupBox Header="Server settings">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="140" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Content="Card server address" ToolTip="{StaticResource Tip.CardServerHost}" />
            <WrapPanel Grid.Row="0" Grid.Column="1">
              <TextBox x:Name="HostBox" Width="110" ToolTip="{StaticResource Tip.CardServerHost}" />
              <TextBlock Text=":" VerticalAlignment="Center" Margin="0,0,6,0" />
              <TextBox x:Name="PortBox" Width="60" ToolTip="{StaticResource Tip.CardServerPort}" />
              <Label Content="wait up to (s)" Margin="10,0,0,0" ToolTip="{StaticResource Tip.PortTimeout}" />
              <TextBox x:Name="TimeoutBox" Width="45" ToolTip="{StaticResource Tip.PortTimeout}" />
              <Label Content="LM → client delay (s)" Margin="10,0,0,0" ToolTip="{StaticResource Tip.LmDelay}" />
              <TextBox x:Name="DelayBox" Width="40" ToolTip="{StaticResource Tip.LmDelay}" />
            </WrapPanel>
            <Button Grid.Row="0" Grid.Column="2" Content="Open web page" Click="OpenWeb_Click"
                    ToolTip="{StaticResource Tip.OpenWeb}" />

            <Label Grid.Row="1" Content="Game Server=" ToolTip="{StaticResource Tip.GameServerIni}" />
            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="GameServerText"
                       VerticalAlignment="Center" TextWrapping="Wrap" ToolTip="{StaticResource Tip.GameServerIni}" />

            <Label Grid.Row="2" Content="Matchmaker" ToolTip="{StaticResource Tip.WizardMatchUrl}" />
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="MatchUrlBox" ToolTip="{StaticResource Tip.WizardMatchUrl}" />

            <Label Grid.Row="3" Content="Tag secret" ToolTip="{StaticResource Tip.WizardTagSecret}" />
            <StackPanel Grid.Row="3" Grid.Column="1">
              <PasswordBox x:Name="TagSecretBox" ToolTip="{StaticResource Tip.WizardTagSecret}" Margin="0,2,6,2" />
              <TextBlock x:Name="TagSecretStatusText" Foreground="Gray" TextWrapping="Wrap" FontSize="11" Margin="0,2,0,0"
                         ToolTip="{StaticResource Tip.WizardTagSecret}" />
            </StackPanel>
            <Button Grid.Row="3" Grid.Column="2" Content="Write server.json" Click="WriteServerJson_Click"
                    ToolTip="{StaticResource Tip.WriteServerJson}" />

            <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" x:Name="ServerJsonPathText"
                       Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,0"
                       ToolTip="{StaticResource Tip.WriteServerJson}" />
            <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" x:Name="WebUiUrlText"
                       TextWrapping="Wrap" Margin="0,2,0,0" ToolTip="{StaticResource Tip.OpenWeb}" />
          </Grid>
        </GroupBox>

        <GroupBox Header="Network (PCB / LM IP)">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="140" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
            </Grid.RowDefinitions>
            <CheckBox Grid.Row="0" Grid.Column="1" x:Name="AutoIpCheck"
                      ToolTip="{StaticResource Tip.AutoDetectIp}">
              <TextBlock TextWrapping="Wrap"
                         Text="Detect this PC's LAN IP for the PCB (client) on every Start" />
            </CheckBox>
            <Button Grid.Row="0" Grid.Column="2" Content="Detect now" Click="DetectIp_Click"
                    ToolTip="{StaticResource Tip.DetectNow}" />

            <Label Grid.Row="1" Content="PCB (client) IP" ToolTip="{StaticResource Tip.PcbIp}" />
            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="PcbIpBox" IsEditable="True" Margin="0,2,6,2"
                      ToolTip="{StaticResource Tip.PcbIp}" />

            <Label Grid.Row="2" Content="LM IP" ToolTip="{StaticResource Tip.LmIp}" />
            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="LmIpBox" IsEditable="True" Margin="0,2,6,2"
                      ToolTip="{StaticResource Tip.LmIp}" />
            <Button Grid.Row="2" Grid.Column="2" Content="Write IPs" Click="WriteIps_Click"
                    ToolTip="{StaticResource Tip.WriteIps}" />

            <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" x:Name="CurrentIpText"
                       TextWrapping="Wrap" Margin="0,6,0,0"
                       ToolTip="{StaticResource Tip.CurrentIps}" />
          </Grid>
        </GroupBox>

        <GroupBox Header="Virtual LAN (n2n) - optional, off by default" x:Name="VlanBox">
          <StackPanel>
            <CheckBox x:Name="VlanEnableCheck" Margin="0,2,0,4" ToolTip="{StaticResource Tip.VlanEnable}"
                      Checked="VlanEnable_Changed" Unchecked="VlanEnable_Changed">
              <TextBlock TextWrapping="Wrap"
                         Text="Use an n2n virtual LAN for this cab (classic LM-over-VPN play with a private group; not the public matchmaker queue)" />
            </CheckBox>
            <Grid x:Name="VlanGrid">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
              </Grid.RowDefinitions>

              <Label Grid.Row="0" Content="edge.exe" ToolTip="{StaticResource Tip.VlanEdge}" />
              <TextBox Grid.Row="0" Grid.Column="1" x:Name="VlanEdgeBox" ToolTip="{StaticResource Tip.VlanEdge}" Margin="0,2,6,2" />
              <Button Grid.Row="0" Grid.Column="2" Content="Browse..." Click="VlanBrowseEdge_Click" ToolTip="{StaticResource Tip.VlanEdge}" />

              <Label Grid.Row="1" Content="Supernode" ToolTip="{StaticResource Tip.VlanSupernode}" />
              <TextBox Grid.Row="1" Grid.Column="1" x:Name="VlanSupernodeBox" ToolTip="{StaticResource Tip.VlanSupernode}" Margin="0,2,6,2" />

              <Label Grid.Row="2" Content="Community" ToolTip="{StaticResource Tip.VlanCommunity}" />
              <PasswordBox Grid.Row="2" Grid.Column="1" x:Name="VlanCommunityBox" ToolTip="{StaticResource Tip.VlanCommunity}" Margin="0,2,6,2" />

              <Label Grid.Row="3" Content="Key" ToolTip="{StaticResource Tip.VlanKey}" />
              <StackPanel Grid.Row="3" Grid.Column="1">
                <PasswordBox x:Name="VlanKeyBox" ToolTip="{StaticResource Tip.VlanKey}" Margin="0,2,6,2" />
                <TextBlock x:Name="VlanKeyStatusText" Foreground="Gray" FontSize="11" TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Row="3" Grid.Column="2" Content="Forget key" Click="VlanForgetKey_Click" ToolTip="{StaticResource Tip.VlanForgetKey}" />

              <Label Grid.Row="4" Content="Virtual IP" ToolTip="{StaticResource Tip.VlanIp}" />
              <WrapPanel Grid.Row="4" Grid.Column="1">
                <ComboBox x:Name="VlanIpModeBox" Width="190" Margin="0,2,6,2" ToolTip="{StaticResource Tip.VlanIp}">
                  <ComboBoxItem Content="Static (fixed address)" />
                  <ComboBoxItem Content="Assigned by supernode" />
                  <ComboBoxItem Content="DHCP from a peer" />
                </ComboBox>
                <TextBox x:Name="VlanStaticIpBox" Width="150" Margin="0,2,6,2" ToolTip="{StaticResource Tip.VlanIp}" />
              </WrapPanel>

              <Label Grid.Row="5" Content="Advanced" ToolTip="{StaticResource Tip.VlanAdvanced}" />
              <WrapPanel Grid.Row="5" Grid.Column="1">
                <Label Content="MTU" ToolTip="{StaticResource Tip.VlanAdvanced}" />
                <TextBox x:Name="VlanMtuBox" Width="50" ToolTip="{StaticResource Tip.VlanAdvanced}" />
                <Label Content="metric" Margin="6,0,0,0" ToolTip="{StaticResource Tip.VlanMetric}" />
                <TextBox x:Name="VlanMetricBox" Width="40" ToolTip="{StaticResource Tip.VlanMetric}" />
                <Label Content="TAP name" Margin="6,0,0,0" ToolTip="{StaticResource Tip.VlanAdapter}" />
                <TextBox x:Name="VlanAdapterBox" Width="110" ToolTip="{StaticResource Tip.VlanAdapter}" />
                <Label Content="description" Margin="6,0,0,0" ToolTip="{StaticResource Tip.VlanDescription}" />
                <TextBox x:Name="VlanDescriptionBox" Width="100" ToolTip="{StaticResource Tip.VlanDescription}" />
              </WrapPanel>

              <WrapPanel Grid.Row="6" Grid.Column="1" Margin="0,2,0,2">
                <CheckBox x:Name="VlanMulticastCheck" Content="Multicast (-E)" Margin="0,0,12,0" ToolTip="{StaticResource Tip.VlanMulticast}" />
                <CheckBox x:Name="VlanRelayCheck" Content="Always relay through supernode (-S1)" Margin="0,0,12,0" ToolTip="{StaticResource Tip.VlanRelay}" />
                <CheckBox x:Name="VlanHeaderCheck" Content="Header encryption (-H)" ToolTip="{StaticResource Tip.VlanHeader}" />
              </WrapPanel>

              <TextBlock Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" x:Name="VlanStatusText" TextWrapping="Wrap"
                         Margin="0,4,0,0" ToolTip="{StaticResource Tip.VlanStatus}" />
              <WrapPanel Grid.Row="7" Grid.Column="2">
                <Button x:Name="VlanConnectButton" Content="Connect" Click="VlanConnect_Click" ToolTip="{StaticResource Tip.VlanConnect}" />
                <Button x:Name="VlanDisconnectButton" Content="Disconnect" Click="VlanDisconnect_Click" ToolTip="{StaticResource Tip.VlanDisconnect}" />
              </WrapPanel>
            </Grid>
            <TextBlock x:Name="VlanTapText" TextWrapping="Wrap" Margin="0,4,0,0">
              <Run x:Name="VlanTapRun" />
              <Hyperlink x:Name="VlanTapLink" NavigateUri="https://build.openvpn.net/downloads/releases/" RequestNavigate="Link_RequestNavigate">official OpenVPN tap-windows downloads</Hyperlink>
            </TextBlock>
          </StackPanel>
        </GroupBox>
      </StackPanel>
    </ScrollViewer>

    <DockPanel Margin="0,8,0,0">
      <TextBlock DockPanel.Dock="Top" Text="Log" FontWeight="SemiBold" ToolTip="{StaticResource Tip.Log}" />
      <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
               VerticalScrollBarVisibility="Auto" Margin="0,2,0,0" ToolTip="{StaticResource Tip.Log}" />
    </DockPanel>
  </DockPanel>
</Window>
