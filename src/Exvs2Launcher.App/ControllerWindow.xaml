<Window x:Class="Exvs2Launcher.App.ControllerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Controller bindings" Width="880" Height="760" MinWidth="740" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        ToolTipService.InitialShowDelay="700"
        ToolTipService.ShowDuration="30000"
        ToolTipService.BetweenShowDelay="200">
  <DockPanel Margin="10">
    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8">
      This screen reads and writes the game's existing controller keys in config.ini
      ([controller], [controller-1], [xinput]). It is not a new input driver. Button ids are
      1-based numbers, comma-separated for more than one button. Combo keys (AB, BC, AC, ABC)
      are expanded into the A/B/C lists the hook reads. A Razer Panthera in PS4 mode usually
      appears as a DirectInput / WinMM device; in PC / XInput mode it appears as an XInput pad.
    </TextBlock>

    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
      <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,0,0,8" />
      <StackPanel Orientation="Horizontal">
        <Button Content="Reload" Click="Reload_Click" ToolTip="{StaticResource Tip.ControllerReload}" />
        <Button Content="Write bindings" FontWeight="Bold" Click="Write_Click" ToolTip="{StaticResource Tip.ControllerWrite}" />
        <Button Content="Close" Click="Close_Click" ToolTip="{StaticResource Tip.ControllerClose}" IsCancel="True" />
      </StackPanel>
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <GroupBox Header="Detected controllers">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="DeviceBox" IsEditable="False" Margin="0,2,6,2"
                      ToolTip="{StaticResource Tip.ControllerDetected}" />
            <Button Grid.Column="1" Content="Refresh" Click="RefreshDevices_Click"
                    ToolTip="{StaticResource Tip.ControllerRefresh}" />
          </Grid>
        </GroupBox>

        <GroupBox Header="[xinput] (config.ini)">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="160" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition /><RowDefinition /><RowDefinition />
            </Grid.RowDefinitions>
            <CheckBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" x:Name="XInputEnabledCheck"
                      Content="EmulatedXInputEnabled" ToolTip="{StaticResource Tip.XInputEnabled}" />
            <Label Grid.Row="1" Content="Mode" ToolTip="{StaticResource Tip.XInputMode}" />
            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="XInputModeBox" IsEditable="True"
                      ToolTip="{StaticResource Tip.XInputMode}" />
            <Label Grid.Row="2" Content="DeviceId" ToolTip="{StaticResource Tip.ControllerDeviceId}" />
            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="XInputDeviceIdBox" IsEditable="True"
                      ToolTip="{StaticResource Tip.ControllerDeviceId}" />
          </Grid>
        </GroupBox>

        <GroupBox Header="Controller 1  [controller]">
          <StackPanel>
            <ContentControl x:Name="Slot1Host" />
          </StackPanel>
        </GroupBox>

        <GroupBox Header="Controller 2  [controller-1]">
          <StackPanel>
            <ContentControl x:Name="Slot2Host" />
          </StackPanel>
        </GroupBox>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
