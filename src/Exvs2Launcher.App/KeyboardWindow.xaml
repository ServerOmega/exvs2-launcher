<Window x:Class="Exvs2Launcher.App.KeyboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Keyboard bindings" Width="820" Height="760" MinWidth="680" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="Window_PreviewKeyDown"
        ToolTipService.InitialShowDelay="700"
        ToolTipService.ShowDuration="30000"
        ToolTipService.BetweenShowDelay="200">
  <DockPanel Margin="10">
    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
               Text="Client and LM keyboard bindings are stored separately. Rebind captures the next key press (8 seconds). Reset puts that action back to the Infinite Boost pack default. This writes the existing INI keys the hook already reads; it is not a new input driver. Only key names the hook knows (Return, UpArr, F3, 1 (NumPad), and the rest of that table) can be written. Shift, Ctrl, Alt, and punctuation are not in that table." />

    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
      <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,0,0,8" />
      <WrapPanel>
        <Button Content="Reload" Click="Reload_Click" ToolTip="{StaticResource Tip.KeyboardReload}" />
        <Button Content="Write bindings" FontWeight="Bold" Click="Write_Click" ToolTip="{StaticResource Tip.KeyboardWrite}" />
        <Button Content="Close" Click="Close_Click" ToolTip="{StaticResource Tip.KeyboardClose}" />
      </WrapPanel>
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <GroupBox Header="Client (config.ini [keyboard])" ToolTip="{StaticResource Tip.KeyboardClient}">
          <StackPanel>
            <ContentControl x:Name="ClientHost" />
            <Button Content="Reset client to pack defaults" Click="ResetClient_Click" Margin="0,8,0,0" HorizontalAlignment="Left"
                    ToolTip="{StaticResource Tip.KeyboardResetAll}" />
          </StackPanel>
        </GroupBox>
        <GroupBox Header="LM (lmnfig.ini [keyboard])" Margin="0,8,0,0" ToolTip="{StaticResource Tip.KeyboardLm}">
          <StackPanel>
            <ContentControl x:Name="LmHost" />
            <Button Content="Reset LM to pack defaults" Click="ResetLm_Click" Margin="0,8,0,0" HorizontalAlignment="Left"
                    ToolTip="{StaticResource Tip.KeyboardResetAll}" />
          </StackPanel>
        </GroupBox>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
