<Window x:Class="Exvs2Launcher.App.ProfileImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import profile" Width="760" Height="600" MinWidth="600" MinHeight="440"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="12">
    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
               Text="Check what this profile will set before adding it. Paths come from someone else's PC, so point them at your own folders." />
    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <Label Content="Profile name" />
      <TextBox x:Name="NameBox" />
      <Label Content="Game folder on this PC" />
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseGame_Click" />
        <TextBox x:Name="GameBox" />
      </DockPanel>
      <Label Content="Card server exe on this PC" />
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseServer_Click" />
        <TextBox x:Name="ServerBox" />
      </DockPanel>
      <StackPanel x:Name="ConflictPanel" Margin="0,8,0,0" Visibility="Collapsed">
        <TextBlock x:Name="ConflictText" TextWrapping="Wrap" Foreground="#FF9A3412" />
        <RadioButton x:Name="AddNewRadio" Content="Add as a new profile" IsChecked="True" Margin="0,4,0,0" Checked="Mode_Changed" />
        <RadioButton x:Name="ReplaceRadio" Content="Replace the existing profile (asks again)" Checked="Mode_Changed" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
        <Button Content="Import" Click="Import_Click" IsDefault="True" FontWeight="SemiBold" Padding="12,4" Margin="0,0,8,0" />
        <Button Content="Cancel" IsCancel="True" Padding="12,4" />
      </StackPanel>
    </StackPanel>
    <ItemsControl x:Name="WarningList" DockPanel.Dock="Bottom" Margin="0,6,0,0">
      <ItemsControl.ItemTemplate>
        <DataTemplate><TextBlock Text="{Binding StringFormat=⚠ {0}}" TextWrapping="Wrap" Foreground="#FF9A3412" /></DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <ListView x:Name="LineList">
      <ListView.View>
        <GridView>
          <GridViewColumn Header="Setting" Width="180" DisplayMemberBinding="{Binding Field}" />
          <GridViewColumn Header="Value" Width="300" DisplayMemberBinding="{Binding Value}" />
          <GridViewColumn Header="Note" Width="220" DisplayMemberBinding="{Binding Note}" />
        </GridView>
      </ListView.View>
    </ListView>
  </DockPanel>
</Window>
